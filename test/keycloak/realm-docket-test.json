{
  "realm": "docket-test",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "users": [
    {
      "username": "staff.user",
      "email": "staff.sso@example.com",
      "firstName": "Staff",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "staffpass",
          "temporary": false
        }
      ],
      "groups": [
        "docket-admins"
      ]
    },
    {
      "username": "customer.user",
      "email": "customer.sso@example.com",
      "firstName": "Customer",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "customerpass",
          "temporary": false
        }
      ],
      "attributes": {
        "cif": [
          "CIF555123"
        ]
      }
    }
  ],
  "groups": [
    {
      "name": "docket-admins"
    }
  ],
  "clients": [
    {
      "clientId": "docket-staff",
      "secret": "staff-client-secret",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:3001/auth/staff_oidc/callback"
      ],
      "defaultClientScopes": [
        "openid",
        "email",
        "profile",
        "groups"
      ]
    },
    {
      "clientId": "docket-customer",
      "secret": "customer-client-secret",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:3001/auth/customer_oidc/callback"
      ],
      "defaultClientScopes": [
        "openid",
        "email",
        "profile",
        "cif"
      ]
    },
    {
      "clientId": "http://localhost:3001/auth/staff_saml/metadata",
      "name": "docket-staff-saml",
      "description": "SAML staff plane — clientId MUST equal the SP entity id Docket sends (Sso.staff_saml_options sp_entity_id, default base_url + /auth/staff_saml/metadata). Keycloak matches the AuthnRequest Issuer and ACS URL against this.",
      "enabled": true,
      "protocol": "saml",
      "publicClient": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://localhost:3001/auth/staff_saml/callback"
      ],
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.server.signature": "true",
        "saml.client.signature": "false",
        "saml.authnstatement": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_name_id_format": "email",
        "saml_assertion_consumer_url_post": "http://localhost:3001/auth/staff_saml/callback",
        "saml_single_logout_service_url_post": "http://localhost:3001/auth/staff_saml/callback",
        "saml_force_name_id_format": "true"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": {
            "user.attribute": "email",
            "attribute.name": "email",
            "attribute.nameformat": "Basic",
            "friendly.name": "email"
          }
        },
        {
          "name": "name",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": {
            "user.attribute": "firstName",
            "attribute.name": "name",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "groups",
          "protocol": "saml",
          "protocolMapper": "saml-group-membership-mapper",
          "config": {
            "attribute.name": "groups",
            "attribute.nameformat": "Basic",
            "single": "true",
            "full.path": "false"
          }
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "openid",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "email",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "groups",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "cif",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "cif",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "cif",
            "claim.name": "cif",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}