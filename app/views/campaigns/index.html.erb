<% page_title t("campaigns.index.title") %>
<div class="page-header">
  <h1><%= t("campaigns.index.title") %></h1>
  <% if policy(Campaign).create? %>
    <%= link_to t("campaigns.index.new"), new_campaign_path, class: "btn btn-primary" %>
  <% end %>
</div>

<% if @campaigns.any? %>
  <div class="table-wrap"><table>
    <thead><tr>
      <th><%= t("campaigns.fields.name") %></th>
      <th><%= t("campaigns.fields.status") %></th>
      <th><%= t("campaigns.fields.channel") %></th>
      <th><%= t("campaigns.index.leads") %></th>
      <th><%= t("campaigns.index.deals") %></th>
      <th><%= t("tables.actions") %></th>
    </tr></thead>
    <tbody><% @campaigns.each do |campaign| %><tr>
      <td><%= link_to campaign.name, campaign_path(campaign) %><br><span class="muted mono"><%= campaign.code %></span></td>
      <td><span class="badge badge-<%= campaign.status_active? ? "open" : "unqualified" %>"><%= campaign.human_status %></span></td>
      <td><%= campaign.human_channel %></td>
      <td><%= @lead_counts[campaign.id] || 0 %></td>
      <td><%= @deal_counts[campaign.id] || 0 %></td>
      <td><% if policy(campaign).update? %><%= link_to t("actions.edit"), edit_campaign_path(campaign), class: "btn btn-sm" %><% end %></td>
    </tr><% end %></tbody>
  </table></div>
<% else %>
  <%= render "shared/empty_state", title: t("campaigns.index.empty") %>
<% end %>
