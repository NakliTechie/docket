<% page_title t(".title") %>
<div class="page-header">
  <h1><%= t(".title") %></h1>
  <div class="page-actions">
    <% if policy(PriceBook).create? %>
      <%= link_to new_price_book_path, class: "btn btn-primary" do %><%= icon "plus" %><%= t(".new_book") %><% end %>
    <% end %>
  </div>
</div>
<p class="page-intro"><%= t(".intro") %></p>

<% if @books.any? %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th><%= t(".columns.name") %></th>
          <th><%= t(".columns.entries") %></th>
          <th><%= t(".columns.status") %></th>
          <th class="actions"><%= t("tables.actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @books.each do |book| %>
          <tr class="<%= "muted-row" unless book.active %>">
            <td><%= book.name %><% if book.is_default? %> <span class="badge"><%= t(".default") %></span><% end %></td>
            <td><%= book.price_book_entries.size %></td>
            <td><span class="badge <%= "badge-success" if book.active %>"><%= book.active ? t(".active") : t(".inactive") %></span></td>
            <td class="actions">
              <% if policy(book).update? %>
                <%= link_to t("actions.edit"), edit_price_book_path(book), class: "btn btn-sm" %>
              <% end %>
              <% if policy(book).destroy? && !book.is_default? %>
                <%= button_to t("actions.delete"), price_book_path(book), method: :delete, class: "btn btn-sm btn-danger",
                      form: { class: "inline-form", data: { turbo_confirm: t(".confirm_delete") } } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <%= render "shared/empty_state", title: t(".empty.title"), hint: t(".empty.hint"),
        action: policy(PriceBook).create? ? link_to(t(".new_book"), new_price_book_path, class: "btn btn-primary") : nil %>
<% end %>
