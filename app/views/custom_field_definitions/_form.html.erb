<%= form_with model: definition, url: definition.persisted? ? custom_field_path(definition) : custom_fields_path,
      scope: :custom_field_definition, class: "form" do |f| %>
  <%= render "shared/form_errors", record: definition %>
  <%= f.hidden_field :resource_type %>

  <div class="form-row">
    <%= f.label :label, t("custom_fields.fields.label") %>
    <%= f.text_field :label, required: true, maxlength: 80 %>
  </div>
  <div class="form-row">
    <%= f.label :key, t("custom_fields.fields.key") %>
    <%= f.text_field :key, required: true, maxlength: 50, disabled: definition.persisted? %>
    <p class="form-hint"><%= t("custom_fields.form.key_hint") %></p>
  </div>
  <div class="form-row">
    <%= f.label :field_type, t("custom_fields.fields.field_type") %>
    <%= f.select :field_type, CustomFieldDefinition::FIELD_TYPES.map { |type|
          [ t("custom_fields.enum.field_type.#{type}"), type ] } %>
  </div>
  <div class="form-row">
    <%= f.label :options_text, t("custom_fields.fields.options") %>
    <%= text_area_tag "custom_field_definition[options_text]", definition.options.join("\n"), rows: 6 %>
    <p class="form-hint"><%= t("custom_fields.form.options_hint") %></p>
  </div>
  <div class="form-row">
    <%= f.label :position, t("custom_fields.fields.position") %>
    <%= f.number_field :position, min: 0, step: 1 %>
  </div>
  <% %i[required active reportable].each do |attribute| %>
    <div class="form-row checkbox-row">
      <%= f.check_box attribute %>
      <%= f.label attribute, t("custom_fields.fields.#{attribute}") %>
    </div>
  <% end %>
  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to t("actions.cancel"), custom_fields_path(resource_type: definition.resource_type), class: "btn" %>
  </div>
<% end %>
