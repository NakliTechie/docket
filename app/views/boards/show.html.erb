<% page_title t(".title", key: @project.key) %>
<div class="page-header">
  <h1><%= link_to @project.key, projects_path, class: "mono" %> <%= @project.name %></h1>
  <div class="page-actions">
    <%= link_to t(".backlog"), project_work_items_path(@project), class: "btn" %>
    <% if feature?("work.sprints") && policy(Sprint).index? %>
      <%= link_to t(".sprints"), project_sprints_path(@project), class: "btn" %>
    <% end %>
    <% if policy(WorkItem).create? %>
      <%= link_to new_project_work_item_path(@project), class: "btn btn-primary" do %>
        <%= icon "plus" %><%= t(".new_item") %>
      <% end %>
    <% end %>
  </div>
</div>

<% if @sprint %>
  <p class="muted">
    <%= t(".scoped_to_sprint", name: @sprint.name) %>
    <%= link_to t(".show_all"), project_board_path(@project, sprint: "all") %>
  </p>
<% end %>

<div data-controller="board">
  <div class="filter-bar">
    <div class="form-row">
      <%= label_tag :board_query, t(".filter") %>
      <%= search_field_tag :board_query, nil,
            data: { board_target: "query", action: "input->board#filter" },
            placeholder: t(".filter_placeholder"), autocomplete: "off" %>
    </div>
    <button type="button" class="btn" data-action="board#clear"><%= t("filters.clear") %></button>
    <span class="muted"><%= t(".filter_hint") %></span>
  </div>

  <%# Dragged moves go through the same transition action as the buttons, so a
      dragged card audits exactly like a clicked one. %>
  <div class="kanban" data-controller="kanban"
       data-kanban-url-template-value="/work_items/:id/transition"
       data-kanban-param-value="workflow_state_id">
    <% @states.each do |state| %>
      <% items = @items_by_state[state.id] || [] %>
      <% total = @totals_by_state[state.id].to_i %>
      <% over = state.over_wip_limit?(total) %>
      <section class="kanban-column<%= " is-over-wip" if over %>"
               data-target-id="<%= state.id %>"
               data-total-count="<%= total %>"
               data-wip-limit="<%= state.wip_limit %>"
               data-board-target="column"
               aria-label="<%= state.name %>"
               data-action="dragover->kanban#dragover drop->kanban#drop dragleave->kanban#dragleave">
        <h2 class="kanban-column-title">
          <button type="button" class="board-collapse" data-action="board#toggleColumn"
                  aria-label="<%= t(".toggle_column", name: state.name) %>">
            <%= state.name %>
          </button>
          <span class="kanban-count"><%= total %></span>
          <% if state.wip_limit.present? %>
            <span class="kanban-wip<%= " is-over" if over %>"
                  title="<%= t(".wip_title", limit: state.wip_limit) %>">/ <%= state.wip_limit %></span>
          <% end %>
        </h2>

        <% if state.wip_limit.present? %>
          <p class="board-wip-warning" <%= "hidden" unless over %>><%= t(".over_wip", limit: state.wip_limit) %></p>
        <% end %>

        <div class="kanban-cards">
          <% items.each do |item| %>
            <% draggable = policy(item).transition? %>
            <article class="kanban-card" draggable="<%= draggable %>" data-item-id="<%= item.id %>"
                     data-board-target="card"
                     <% if draggable %>data-action="dragstart->kanban#dragstart dragend->kanban#dragend"<% end %>>
              <div class="kanban-card-head">
                <%= link_to item.reference, work_item_path(item), class: "mono" %>
                <span class="badge badge-<%= item.priority %>"><%= item.human_priority %></span>
              </div>
              <%= link_to item.title, work_item_path(item), class: "kanban-card-title" %>
              <div class="kanban-card-meta"><%= item.human_kind %></div>
              <div class="kanban-card-meta"><%= item.assignee&.name || t("work_items.unassigned") %></div>
            </article>
          <% end %>
          <% if items.empty? %>
            <p class="muted board-column-empty"><%= t(".empty_column") %></p>
          <% elsif total > items.size %>
            <p class="muted board-column-empty">
              <%= t(".truncated", shown: items.size, total: total) %>
              <%= link_to t(".see_all"), project_work_items_path(@project, state_id: state.id) %>
            </p>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</div>
