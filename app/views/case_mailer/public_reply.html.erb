<p><%= t("case_mailer.public_reply.greeting", name: @case.contact.name) %></p>
<p><%= t("case_mailer.public_reply.body", tracking_id: @case.tracking_id) %></p>
<blockquote style="border-left: 3px solid #1a4480; padding-left: 12px;"><%= RichText.render(@message.body) %></blockquote>
<p><%= t("case_mailer.public_reply.instructions") %></p>
<div><%= RichText.render(@message.signature || t("case_mailer.signature")) %></div>
