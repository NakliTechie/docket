<%= form_with model: kase, class: "form" do |f| %>
  <%= render "shared/form_errors", record: kase %>
  <%# Carry the lock_version the editor saw so a concurrent edit is caught
      as a StaleObjectError rather than silently overwritten. %>
  <%= f.hidden_field :lock_version if kase.persisted? %>

  <div class="form-row <%= "field-error" if kase.errors[:subject].any? %>">
    <%= f.label :subject, t("cases.fields.subject") %>
    <%= f.text_field :subject, required: true %>
    <% kase.errors[:subject].each do |msg| %><p class="field-error-message"><%= msg %></p><% end %>
  </div>

  <div class="form-row <%= "field-error" if kase.errors[:contact].any? %>">
    <%= f.label :contact_id, t("cases.fields.contact") %>
    <%= f.collection_select :contact_id, Contact.order(:name), :id, :name,
          { include_blank: t("forms.select_prompt") }, required: !kase.new_record? %>
    <% if kase.new_record? && policy(Contact).create? %>
      <p class="form-hint"><%= t("cases.form.contact_choice") %></p>
      <details class="inline-contact panel" <%= "open" if Contact.none? %>>
        <summary><%= t("cases.form.new_contact") %></summary>
        <p class="form-hint"><%= t("cases.form.new_contact_hint") %></p>
        <%= fields_for :new_contact, @inline_contact || Contact.new do |contact_fields| %>
          <div class="form-row <%= "field-error" if @inline_contact&.errors&.[](:name)&.any? %>">
            <%= contact_fields.label :name, t("contacts.fields.name") %>
            <%= contact_fields.text_field :name %>
            <% @inline_contact&.errors&.[](:name)&.each do |msg| %>
              <p class="field-error-message"><%= msg %></p>
            <% end %>
          </div>
          <div class="form-row <%= "field-error" if @inline_contact&.errors&.[](:email)&.any? %>">
            <%= contact_fields.label :email, t("contacts.fields.email") %>
            <%= contact_fields.email_field :email %>
            <% @inline_contact&.errors&.[](:email)&.each do |msg| %>
              <p class="field-error-message"><%= msg %></p>
            <% end %>
          </div>
          <div class="form-row">
            <%= contact_fields.label :phone, t("contacts.fields.phone") %>
            <%= contact_fields.telephone_field :phone %>
          </div>
        <% end %>
      </details>
    <% end %>
    <% kase.errors[:contact].each do |msg| %><p class="field-error-message"><%= msg %></p><% end %>
  </div>

  <div class="form-row">
    <%= f.label :description, t("cases.fields.description") %>
    <%= f.text_area :description %>
  </div>

  <div class="form-row">
    <%= f.label :priority, t("cases.fields.priority") %>
    <%= f.select :priority, Case.priorities.keys.map { |p| [ t("cases.enum.priority.#{p}"), p ] } %>
  </div>

  <div class="form-row">
    <%= f.label :queue_id, t("cases.fields.queue") %>
    <%= f.collection_select :queue_id, CaseQueue.order(:name), :id, :name,
          include_blank: t("cases.no_queue") %>
  </div>

  <div class="form-row">
    <%= f.label :category_id, t("cases.fields.category") %>
    <%= f.collection_select :category_id, Category.order(:name), :id, :name,
          include_blank: t("cases.uncategorised") %>
  </div>

  <div class="form-row">
    <%= f.label :assignee_id, t("cases.fields.assignee") %>
    <%= f.collection_select :assignee_id, User.case_assignees.order(:name), :id, :name,
          include_blank: t("cases.unassigned") %>
  </div>

  <div class="form-row">
    <%= f.label :sla_policy_id, t("cases.fields.sla_policy") %>
    <%= f.collection_select :sla_policy_id, SlaPolicy.order(:name), :id, :name,
          include_blank: t("cases.form.default_sla") %>
  </div>

  <%= render "shared/custom_fields", record: kase, resource_type: "cases" %>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to t("actions.cancel"), kase.persisted? ? case_path(kase) : cases_path, class: "btn" %>
  </div>
<% end %>
