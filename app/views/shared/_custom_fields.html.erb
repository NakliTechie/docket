<% definitions = CustomFieldDefinition.for_resource(resource_type).active.ordered %>
<% if definitions.any? %>
  <% prefix = record.model_name.param_key %>
  <fieldset class="custom-fields">
    <legend><%= t("custom_fields.section") %></legend>
    <% definitions.each do |definition| %>
      <% name = "#{prefix}[custom_fields][#{definition.key}]" %>
      <% id = "#{prefix}_custom_fields_#{definition.key}" %>
      <% value = record.custom_fields.to_h[definition.key] %>
      <div class="form-row">
        <%= label_tag id, definition.label %>
        <% case definition.field_type %>
        <% when "long_text" %>
          <%= text_area_tag name, value, id: id, rows: 4, required: definition.required? %>
        <% when "integer" %>
          <%= number_field_tag name, value, id: id, step: 1, required: definition.required? %>
        <% when "decimal" %>
          <%= number_field_tag name, value, id: id, step: "any", required: definition.required? %>
        <% when "boolean" %>
          <%= hidden_field_tag name, "0", id: nil %>
          <%= check_box_tag name, "1", value == true, id: id %>
        <% when "date" %>
          <%= date_field_tag name, value, id: id, required: definition.required? %>
        <% when "single_select" %>
          <%= select_tag name, options_for_select(definition.options, value), id: id,
                         include_blank: !definition.required?, required: definition.required? %>
        <% when "multi_select" %>
          <%= select_tag "#{name}[]", options_for_select(definition.options, Array(value)), id: id,
                         multiple: true, required: definition.required? %>
        <% else %>
          <%= text_field_tag name, value, id: id, maxlength: 255, required: definition.required? %>
        <% end %>
      </div>
    <% end %>
  </fieldset>
<% end %>
