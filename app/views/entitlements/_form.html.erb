<%= form_with model: entitlement, class: "form" do |f| %>
  <%= render "shared/form_errors", record: entitlement %>

  <div class="form-row">
    <%= f.label :name, t("entitlements.fields.name") %>
    <%= f.text_field :name, required: true %>
  </div>
  <div class="form-row">
    <%= f.label :sla_policy_id, t("entitlements.fields.sla_policy") %>
    <%= f.collection_select :sla_policy_id, SlaPolicy.order(:name), :id, :name,
                            { include_blank: t("entitlements.form.choose_policy") }, required: true %>
  </div>

  <fieldset>
    <legend><%= t("entitlements.fields.holder") %></legend>
    <p class="form-hint"><%= t("entitlements.form.holder_hint") %></p>
    <div class="form-row">
      <%= f.label :organisation_id, t("entitlements.fields.organisation") %>
      <%= f.collection_select :organisation_id, Organisation.order(:name), :id, :name,
                              { include_blank: t("entitlements.form.no_organisation") } %>
    </div>
    <div class="form-row">
      <%= f.label :contact_id, t("entitlements.fields.contact") %>
      <%= f.collection_select :contact_id, Contact.order(:name), :id, :name,
                              { include_blank: t("entitlements.form.no_contact") } %>
    </div>
  </fieldset>

  <div class="filter-bar">
    <div class="form-row">
      <%= f.label :starts_at, t("entitlements.fields.starts_at") %>
      <%= f.datetime_local_field :starts_at, required: true %>
    </div>
    <div class="form-row">
      <%= f.label :ends_at, t("entitlements.fields.ends_at") %>
      <%= f.datetime_local_field :ends_at %>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to t("actions.cancel"), entitlements_path, class: "btn" %>
  </div>
<% end %>
