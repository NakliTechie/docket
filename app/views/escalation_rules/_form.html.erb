<%= form_with model: rule, url: rule.persisted? ? escalation_rule_path(rule) : escalation_rules_path,
      scope: :escalation_rule, class: "form" do |f| %>
  <%= render "shared/form_errors", record: rule %>

  <div class="form-row <%= "field-error" if rule.errors[:name].any? %>">
    <%= f.label :name, t("escalation_rules.fields.name") %>
    <%= f.text_field :name, required: true %>
    <% rule.errors[:name].each do |msg| %><p class="field-error-message"><%= msg %></p><% end %>
  </div>

  <div class="form-row">
    <label class="checkbox-row">
      <%= f.check_box :active %>
      <%= t("escalation_rules.fields.active") %>
    </label>
    <p class="form-hint"><%= t("escalation_rules.form.active_hint") %></p>
  </div>

  <fieldset>
    <legend><%= t("escalation_rules.form.when_legend") %></legend>

    <div class="form-row">
      <%= f.label :trigger_type, t("escalation_rules.fields.trigger_type") %>
      <%= f.select :trigger_type,
            EscalationRule.trigger_types.keys.map { |t| [ I18n.t("escalation_rules.enum.trigger_type.#{t}"), t ] } %>
      <p class="form-hint"><%= t("escalation_rules.form.trigger_hint") %></p>
    </div>

    <div class="form-row">
      <%= f.label :breach_clock, t("escalation_rules.fields.breach_clock") %>
      <%= f.select :breach_clock,
            EscalationRule::BREACH_CLOCKS.map { |c| [ t("escalation_rules.enum.breach_clock.#{c}"), c ] } %>
      <p class="form-hint"><%= t("escalation_rules.form.breach_clock_hint") %></p>
    </div>

    <div class="form-row">
      <%= f.label :if_status, t("escalation_rules.fields.if_status") %>
      <%= f.select :if_status, Case.statuses.keys.map { |s| [ t("cases.enum.status.#{s}"), s ] },
            { include_blank: t("escalation_rules.form.any_status") } %>
      <p class="form-hint"><%= t("escalation_rules.form.if_status_hint") %></p>
    </div>

    <div class="form-row">
      <%= f.label :if_priority, t("escalation_rules.fields.if_priority") %>
      <%= f.select :if_priority, Case.priorities.keys.map { |p| [ t("cases.enum.priority.#{p}"), p ] },
            { include_blank: t("escalation_rules.form.any") } %>
    </div>
  </fieldset>

  <fieldset>
    <legend><%= t("escalation_rules.form.tiers_legend") %></legend>
    <p class="form-hint"><%= t("escalation_rules.form.tiers_hint") %></p>

    <%= f.fields_for :escalation_levels do |lf| %>
      <div class="filter-bar">
        <div class="form-row">
          <%= lf.label :after_minutes, t("escalation_rules.fields.after_minutes") %>
          <%= lf.number_field :after_minutes, min: 1, max: 525_600 %>
        </div>
        <div class="form-row">
          <%= lf.label :then_assignee_id, t("escalation_rules.fields.then_assignee") %>
          <%= lf.collection_select :then_assignee_id, User.case_assignees.order(:name), :id, :display_label,
                { include_blank: t("escalation_rules.form.keep") } %>
        </div>
        <div class="form-row">
          <%= lf.label :notify_user_id, t("escalation_rules.fields.notify_user") %>
          <%= lf.collection_select :notify_user_id, User.where(active: true).order(:name), :id, :name,
                { include_blank: t("escalation_rules.form.no_one") } %>
        </div>
        <% if lf.object.persisted? %>
          <label class="checkbox-row">
            <%= lf.check_box :_destroy %>
            <%= t("escalation_rules.form.remove_tier") %>
          </label>
        <% end %>
      </div>
    <% end %>
  </fieldset>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to t("actions.cancel"), escalation_rules_path, class: "btn" %>
  </div>
<% end %>
