<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="referrer" content="same-origin">
    <% if page_description.present? %>
      <meta name="description" content="<%= page_description %>">
    <% end %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>

  <body <%= "data-controller=hotkeys" if authenticated? %>>
    <a class="skip-link" href="#main"><%= t("layout.skip_to_content") %></a>

    <% if authenticated? %>
      <%= turbo_stream_from Current.user, :notifications %>
      <header class="app-header">
        <nav class="app-nav" aria-label="<%= t("layout.primary_navigation") %>"
             data-controller="navigation"
             data-action="keydown@window->navigation#keydown click->navigation#closeFromLink">
          <%= link_to brand_name, root_path, class: "brand" %>
          <button type="button" class="nav-menu-toggle"
                  aria-controls="staff-navigation" aria-expanded="false"
                  data-navigation-target="toggle" data-action="navigation#toggle">
            <%= t("layout.nav.menu") %>
          </button>

          <div id="staff-navigation" class="app-nav-links">
            <%= nav_link t("layout.nav.home"), root_path, active: controller_name.in?(%w[home setup]) %>

            <% if feature?("service_desk") %>
              <%= nav_link t("layout.nav.inbox"), cases_path, active: controller_name == "cases" %>
            <% end %>

            <% if first_run_setup? %>
              <% if feature?("service_desk.portal") %>
                <%= nav_link t("layout.nav.customer_portal"), portal_root_path %>
              <% end %>
              <%= nav_group t("layout.nav.explore"), active: false do %>
                <%= nav_link t("layout.nav.customers"), contacts_path %>
                <% if feature?("crm") && policy(Lead).index? %>
                  <%= nav_link t("layout.nav.sales"), leads_path %>
                <% end %>
                <% if feature?("work") && policy(Project).index? %>
                  <%= nav_link t("layout.nav.delivery"), projects_path %>
                <% end %>
                <% if policy(ReferenceDoc).index? %>
                  <%= nav_link t("layout.nav.knowledge_automation"), admin_reference_docs_path %>
                <% end %>
                <% if DashboardPolicy.new(Current.user, :dashboard).index? %>
                  <%= nav_link t("layout.nav.insights"), dashboard_path %>
                <% end %>
                <%= nav_link t("layout.nav.administration"), admin_settings_path %>
              <% end %>
            <% else %>
            <%= nav_group t("layout.nav.customers"),
                  active: %w[contacts organisations].include?(controller_name) do %>
              <%= nav_link t("layout.nav.contacts"), contacts_path, active: controller_name == "contacts" %>
              <%= nav_link t("layout.nav.organisations"), organisations_path, active: controller_name == "organisations" %>
            <% end %>

            <% if feature?("crm") && policy(Lead).index? %>
              <%= nav_group t("layout.nav.sales"),
                    active: %w[leads lead_capture_forms deals products price_books competitors campaigns pipelines lead_routing_rules activities sequences sales_reports].include?(controller_name) do %>
                <%= nav_link t("layout.nav.leads"), leads_path, active: controller_name == "leads" %>
                <%= nav_link t("layout.nav.deals"), deals_path, active: controller_name == "deals" %>
                <% if policy(Activity).index? %>
                  <%= nav_link t("layout.nav.activities"), activities_path, active: controller_name == "activities" %>
                <% end %>
                <%= nav_link t("layout.nav.sales_report"), sales_report_path, active: controller_name == "sales_reports" %>
                <% if policy(Pipeline).create? %>
                  <%= nav_link t("layout.nav.pipelines"), pipelines_path, active: controller_name == "pipelines" %>
                  <%= nav_link t("layout.nav.lead_routing_rules"), lead_routing_rules_path, active: controller_name == "lead_routing_rules" %>
                  <%= nav_link t("layout.nav.lead_scorecard"), admin_lead_scorecard_path, active: controller_name == "lead_scorecards" %>
                  <%= nav_link t("layout.nav.products"), products_path, active: controller_name == "products" %>
                  <%= nav_link t("layout.nav.price_books"), price_books_path, active: controller_name == "price_books" %>
                  <%= nav_link t("layout.nav.competitors"), competitors_path, active: controller_name == "competitors" %>
                  <%= nav_link t("layout.nav.campaigns"), campaigns_path, active: controller_name == "campaigns" %>
                  <% if feature?("crm.sequences") %>
                    <%= nav_link t("layout.nav.sequences"), sequences_path, active: controller_name == "sequences" %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>

            <% if feature?("work") && policy(Project).index? %>
              <%= nav_link t("layout.nav.delivery"), projects_path,
                    active: %w[projects boards work_items].include?(controller_name) %>
            <% end %>

            <% webhook_policy = PlatformAreaPolicy.new(Current.user, :webhooks) %>
            <% if policy(CaseQueue).create? || policy(ReferenceDoc).index? ||
                  policy(ConnectorInvocation).index? %>
              <%= nav_group t("layout.nav.knowledge_automation"),
                    active: %w[case_queues categories sla_policies entitlements business_calendars macros routing_rules escalation_rules custom_field_definitions approval_processes reference_docs knowledge_categories connector_invocations decision_appeals approval_requests].include?(controller_name) do %>
                <% if policy(CaseQueue).create? %>
                  <%= nav_link t("layout.nav.queues"), case_queues_path, active: controller_name == "case_queues" %>
                  <%= nav_link t("layout.nav.categories"), categories_path, active: controller_name == "categories" %>
                  <%= nav_link t("layout.nav.sla_policies"), sla_policies_path, active: controller_name == "sla_policies" %>
                  <%= nav_link t("layout.nav.entitlements"), entitlements_path, active: controller_name == "entitlements" %>
                  <%= nav_link t("layout.nav.business_calendars"), business_calendars_path, active: controller_name == "business_calendars" %>
                  <%= nav_link t("layout.nav.macros"), macros_path, active: controller_name == "macros" %>
                <% end %>
                <% if policy(RoutingRule).index? %>
                  <%= nav_link t("layout.nav.routing_rules"), routing_rules_path, active: controller_name == "routing_rules" %>
                <% end %>
                <% if policy(EscalationRule).index? %>
                  <%= nav_link t("layout.nav.escalation_rules"), escalation_rules_path, active: controller_name == "escalation_rules" %>
                <% end %>
                <% if policy(CustomFieldDefinition).index? %>
                  <%= nav_link t("layout.nav.custom_fields"), custom_fields_path,
                               active: controller_name == "custom_field_definitions" %>
                <% end %>
                <% if policy(ApprovalProcess).index? %>
                  <%= nav_link t("layout.nav.approval_processes"), approval_processes_path, active: controller_name == "approval_processes" %>
                <% end %>
                <% if policy(ReferenceDoc).index? %>
                  <%= nav_link t("layout.nav.reference_docs"), admin_reference_docs_path,
                               active: %w[reference_docs knowledge_categories].include?(controller_name) %>
                <% end %>
                <% if policy(ConnectorInvocation).index? %>
                  <%= nav_link t("layout.nav.agent_actions"), admin_connector_invocations_path, active: controller_name == "connector_invocations" %>
                <% end %>
                <% if policy(DecisionAppeal).index? %>
                  <%= nav_link t("layout.nav.decision_appeals"), admin_decision_appeals_path, active: controller_name == "decision_appeals" %>
                <% end %>
                <% if policy(ApprovalRequest).index? %>
                  <%= nav_link t("layout.nav.approval_requests"), admin_approval_requests_path, active: controller_name == "approval_requests" %>
                <% end %>
              <% end %>
            <% end %>

            <% if DashboardPolicy.new(Current.user, :dashboard).index? %>
              <%= nav_link t("layout.nav.insights"), dashboard_path, active: controller_name == "dashboards" %>
            <% end %>

            <% settings_policy = PlatformAreaPolicy.new(Current.user, :settings) %>
            <% service_accounts_policy = PlatformAreaPolicy.new(Current.user, :service_accounts) %>
            <% if policy(User).index? || settings_policy.index? || policy(Connector).index? ||
                  webhook_policy.index? || service_accounts_policy.index? %>
              <%= nav_group t("layout.nav.administration"),
                    active: %w[setup users roles tenants activity audit security_events service_accounts api_tokens shared_credentials settings connectors webhook_endpoints].include?(controller_name) do %>
                <% if settings_policy.index? %>
                  <%= nav_section t("layout.nav.workspace_section") %>
                  <%= nav_link t("layout.nav.setup"), setup_path, active: controller_name == "setup" %>
                  <%= nav_link t("layout.nav.settings"), admin_settings_path, active: controller_name == "settings" %>
                <% end %>

                <% if policy(User).index? %>
                  <%= nav_section t("layout.nav.people_access") %>
                  <%= nav_link t("layout.nav.users"), admin_users_path, active: controller_name == "users" %>
                  <%= nav_link t("layout.nav.roles"), admin_roles_path, active: controller_name == "roles" %>
                  <% if policy(Tenant).index? %>
                    <%= nav_link t("layout.nav.tenants"), admin_tenants_path, active: controller_name == "tenants" %>
                  <% end %>
                <% end %>

                <% if service_accounts_policy.index? || policy(Connector).index? || webhook_policy.index? %>
                  <%= nav_section t("layout.nav.channels_integrations") %>
                <% end %>
                <% if service_accounts_policy.index? %>
                  <%= nav_link t("layout.nav.api_access"), admin_service_accounts_path,
                        active: %w[service_accounts api_tokens].include?(controller_name) %>
                <% end %>
                <% if policy(Connector).index? %>
                  <%= nav_link t("layout.nav.connectors"), admin_connectors_path, active: controller_name == "connectors" %>
                <% end %>
                <% if webhook_policy.index? %>
                  <%= nav_link t("layout.nav.webhooks"), admin_webhook_endpoints_path, active: controller_name == "webhook_endpoints" %>
                <% end %>

                <% if policy(User).index? %>
                  <%= nav_section t("layout.nav.security_audit") %>
                  <%= nav_link t("layout.nav.team_activity"), admin_activity_path, active: controller_name == "activity" %>
                  <%= nav_link t("layout.nav.change_history"), admin_audit_path, active: controller_name == "audit" %>
                  <%= nav_link t("layout.nav.sign_in_security"), admin_security_events_path, active: controller_name == "security_events" %>
                <% end %>
              <% end %>
            <% end %>
            <% end %>
          </div>
        </nav>
        <div class="app-header-right">
          <%= form_with url: search_path, method: :get, class: "inline-form header-search", role: "search" do |f| %>
            <%= f.label :q, t("search.index.label"), for: "global-search", class: "visually-hidden" %>
            <%= f.search_field :q, id: "global-search", value: params[:q],
                  placeholder: t("search.index.short_placeholder") %>
          <% end %>
          <%= link_to notifications_path, class: "notification-link",
                      aria: { label: t("layout.nav.notifications") } do %>
            <%= icon "alert" %>
            <%= render "notifications/badge", user: Current.user %>
          <% end %>
          <button type="button" class="btn btn-ghost btn-sm" data-action="hotkeys#openHelp"
                  aria-haspopup="dialog" aria-controls="help-modal">
            <%= icon "help" %><span class="visually-hidden"><%= t("help.title") %></span>
          </button>
          <%= button_to t("layout.locale_switch_label"), locale_path(locale: I18n.locale == :en ? "hi" : "en"),
                        class: "btn btn-ghost btn-sm", form: { class: "inline-form" } %>
          <span class="current-user"><%= Current.user.name %> · <%= role_badge(Current.user) %></span>
          <%= button_to t("layout.sign_out"), session_path, method: :delete,
                        class: "btn btn-ghost btn-sm", form: { class: "inline-form" } %>
        </div>
      </header>
    <% end %>

    <main id="main" class="app-main">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <% if authenticated? %>
      <%= render "shared/help_modal" %>
      <%= render "shared/command_palette" %>
    <% end %>
  </body>
</html>
