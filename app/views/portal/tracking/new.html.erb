<% page_title t(".title") %>
<div class="portal-card">
  <h1><%= t(".title") %></h1>
  <p class="muted"><%= t(".intro") %></p>

  <%# Native submission, not Turbo: the lookup answers 200 with the case (it
      creates nothing, and a redirect would put the tracking ID in the URL —
      the one thing G2 was written to prevent). Turbo discards a 200 response
      to a form POST, so the customer saw the unchanged form. %>
  <%= form_with url: portal_track_lookup_path, class: "form", data: { turbo: false } do |f| %>
    <div class="form-row">
      <%= f.label :tracking_id, t(".tracking_id") %>
      <%= f.text_field :tracking_id, required: true,
            value: params[:tracking_id].presence || @prefill_tracking_id,
            placeholder: "DKT-XXXX-XXXX", class: "mono" %>
    </div>
    <div class="form-row">
      <%= f.label :contact_email, t(".email") %>
      <%= f.email_field :contact_email, value: params[:contact_email] %>
      <p class="form-hint"><%= t(".challenge_hint") %></p>
    </div>
    <div class="form-row">
      <%= f.label :contact_phone, t(".phone") %>
      <%= f.telephone_field :contact_phone, value: params[:contact_phone] %>
    </div>
    <div class="form-actions">
      <%= f.submit t(".check"), class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
