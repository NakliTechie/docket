<% page_title t(".title") %>
<div class="page-header">
  <h1><%= t(".title") %></h1>
  <div class="page-actions">
    <% if policy(Project).create? %>
      <%= link_to t("project_templates.index.title"), project_templates_path, class: "btn" %>
      <%= link_to new_project_path, class: "btn btn-primary" do %>
        <%= icon "plus" %><%= t(".new_project") %>
      <% end %>
    <% end %>
  </div>
</div>

<div class="filter-bar">
  <%= link_to t(".show_active"), projects_path, class: "btn#{' btn-active' unless params[:archived] == '1'}" %>
  <%= link_to t(".show_archived"), projects_path(archived: "1"), class: "btn#{' btn-active' if params[:archived] == '1'}" %>
</div>

<% if @projects.any? %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th><%= t(".columns.key") %></th>
          <th><%= t(".columns.name") %></th>
          <th><%= t(".columns.lead") %></th>
          <th><%= t(".columns.visibility") %></th>
          <th><%= t(".columns.open_items") %></th>
          <th><%= t("tables.actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @projects.each do |project| %>
          <tr>
            <td class="mono"><%= link_to project.key, project_board_path(project) %></td>
            <td><%= project.name %></td>
            <td><%= project.lead&.name || t("forms.none") %></td>
            <td><%= project.human_visibility %></td>
            <td><%= @open_counts[project.id].to_i %></td>
            <td class="table-actions">
              <%= link_to t(".backlog"), project_work_items_path(project), class: "btn btn-sm" %>
              <% if policy(project).update? %>
                <%= link_to t("actions.edit"), edit_project_path(project), class: "btn btn-sm" %>
                <%= button_to project.archived? ? t(".unarchive") : t(".archive"),
                      archive_project_path(project), class: "btn btn-sm" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <%= render "shared/empty_state", title: t(".empty.title"), hint: t(".empty.hint") %>
<% end %>
