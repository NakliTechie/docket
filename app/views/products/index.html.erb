<% page_title t("products.index.title") %>
<div class="page-header"><h1><%= t("products.index.title") %></h1>
  <%= link_to t("products.index.new"), new_product_path, class: "btn btn-primary" %></div>
<% if @products.any? %><div class="table-wrap"><table>
  <thead><tr><th><%= t("products.fields.sku") %></th><th><%= t("products.fields.name") %></th>
    <th><%= t("products.fields.price") %></th><th><%= t("products.fields.active") %></th><th><%= t("tables.actions") %></th></tr></thead>
  <tbody><% @products.each do |product| %><tr>
    <td class="mono"><%= product.sku %></td><td><%= product.name %></td>
    <td><%= product.default_unit_price_cents ? format_money(product.default_unit_price_cents, product.currency) : "—" %></td>
    <td><%= product.active? ? t("forms.yes") : t("forms.no") %></td>
    <td><%= link_to t("actions.edit"), edit_product_path(product), class: "btn btn-sm" %></td>
  </tr><% end %></tbody>
</table></div><% else %><%= render "shared/empty_state", title: t("products.index.empty") %><% end %>
