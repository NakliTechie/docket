<%= form_with model: [ :admin, service_account ], class: "form" do |f| %>
  <%= render "shared/form_errors", record: service_account %>

  <div class="form-row">
    <%= f.label :name, t("admin.service_accounts.fields.name") %>
    <%= f.text_field :name, required: true, placeholder: t("admin.service_accounts.fields.name_placeholder") %>
  </div>

  <div class="form-row">
    <%= f.label :description, t("admin.service_accounts.fields.description") %>
    <%= f.text_field :description %>
  </div>

  <fieldset>
    <legend><%= t("admin.service_accounts.fields.scopes") %></legend>
    <p class="form-hint"><%= t("admin.service_accounts.fields.scopes_hint") %></p>
    <%# Empty-array companion: without it, unchecking every box submits no %>
    <%# scopes[] param at all, so the update silently keeps the old scopes %>
    <%# instead of surfacing the "at least one scope" validation error. %>
    <%= hidden_field_tag "service_account[scopes][]", "" %>
    <% ServiceAccount::SCOPES.each do |scope| %>
      <div class="checkbox-row">
        <%= check_box_tag "service_account[scopes][]", scope,
              service_account.scopes&.include?(scope), id: "scope_#{scope.parameterize}" %>
        <label for="scope_<%= scope.parameterize %>" class="mono"><%= scope %></label>
      </div>
    <% end %>
  </fieldset>

  <fieldset>
    <legend><%= t("admin.service_accounts.fields.connector_grants") %></legend>
    <p class="form-hint"><%= t("admin.service_accounts.fields.connector_grants_hint") %></p>
    <% if @grantable_connectors.any? %>
      <% selection = service_account.connector_grant_selection %>
      <% @grantable_connectors.each do |connector| %>
        <div class="panel">
          <strong><%= connector.name %></strong>
          <div class="table-meta"><%= connector.provider_descriptor&.label || connector.provider.humanize %></div>
          <%= hidden_field_tag "service_account[connector_grant_selection][#{connector.id}][]", "" %>
          <% connector.enabled_actions.each do |action_key| %>
            <% input_id = "connector_grant_#{connector.id}_#{action_key.parameterize}" %>
            <div class="checkbox-row">
              <%= check_box_tag "service_account[connector_grant_selection][#{connector.id}][]", action_key,
                    Array(selection[connector.id.to_s]).include?(action_key), id: input_id %>
              <%= label_tag input_id, action_key, class: "mono" %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <p class="muted"><%= t("admin.service_accounts.fields.connector_grants_empty") %></p>
    <% end %>
  </fieldset>

  <fieldset>
    <legend><%= t("admin.service_accounts.fields.budget") %></legend>
    <p class="form-hint"><%= t("admin.service_accounts.fields.budget_hint") %></p>
    <div class="form-row">
      <%= f.label :action_budget, t("admin.service_accounts.fields.action_budget") %>
      <%= f.number_field :action_budget, min: 1, placeholder: t("admin.service_accounts.fields.action_budget_placeholder") %>
    </div>
    <div class="form-row">
      <%= f.label :action_budget_window_minutes, t("admin.service_accounts.fields.action_budget_window") %>
      <%= f.number_field :action_budget_window_minutes, min: 1, placeholder: "60" %>
    </div>
  </fieldset>

  <% unless service_account.new_record? %>
    <div class="checkbox-row form-row">
      <%= f.check_box :active %>
      <%= f.label :active, t("admin.service_accounts.fields.active") %>
    </div>
  <% end %>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to t("actions.cancel"), admin_service_accounts_path, class: "btn" %>
  </div>
<% end %>
