<%= form_with model: [ :admin, user ], class: "form" do |f| %>
  <%= render "shared/form_errors", record: user %>

  <div class="form-row <%= "field-error" if user.errors[:name].any? %>">
    <%= f.label :name, t("admin.users.fields.name") %>
    <%= f.text_field :name, required: true %>
    <% user.errors[:name].each do |msg| %><p class="field-error-message"><%= msg %></p><% end %>
  </div>

  <div class="form-row <%= "field-error" if user.errors[:email_address].any? %>">
    <%= f.label :email_address, t("admin.users.fields.email") %>
    <%= f.email_field :email_address, required: true %>
    <% user.errors[:email_address].each do |msg| %><p class="field-error-message"><%= msg %></p><% end %>
  </div>

  <div class="form-row <%= "field-error" if user.errors[:password].any? %>">
    <%= f.label :password, t("admin.users.fields.password") %>
    <%= f.password_field :password, autocomplete: "new-password",
          required: user.new_record? %>
    <% unless user.new_record? %><p class="form-hint"><%= t("admin.users.form.password_hint") %></p><% end %>
    <% user.errors[:password].each do |msg| %><p class="field-error-message"><%= msg %></p><% end %>
  </div>

  <div class="form-row">
    <%= f.label :role, t("admin.users.fields.role") %>
    <%# Only functional roles are assignable; a not-yet-migrated user's legacy
        role is kept in the list so editing them doesn't silently reassign. %>
    <%= f.select :role, (Authz::ASSIGNABLE_ROLES | [ user.role ]).compact.map { |r| [ t("users.enum.role.#{r}"), r ] } %>
  </div>

  <% scope_editable = user.new_record? || policy(user).update_scope? %>
  <fieldset>
    <legend><%= t("admin.users.fields.record_scope") %></legend>
    <p class="form-hint"><%= t("admin.users.form.record_scope_hint") %></p>
    <% if scope_editable %>
      <div class="form-row">
        <%= f.label :record_read_scope, t("admin.users.fields.record_read_scope") %>
        <%= f.select :record_read_scope,
              User.record_read_scopes.keys.map { |scope| [ t("admin.users.record_scopes.#{scope}"), scope ] } %>
      </div>
      <div class="form-row">
        <%= f.label :record_write_scope, t("admin.users.fields.record_write_scope") %>
        <%= f.select :record_write_scope,
              User.record_write_scopes.keys.map { |scope| [ t("admin.users.record_scopes.#{scope}"), scope ] } %>
      </div>

      <fieldset>
        <legend><%= t("admin.users.fields.teams") %></legend>
        <%= f.collection_check_boxes :team_ids, Team.order(:name), :id, :name do |b| %>
          <div class="checkbox-row"><%= b.check_box %><%= b.label %></div>
        <% end %>
      </fieldset>

      <fieldset>
        <legend><%= t("admin.users.fields.scoped_accounts") %></legend>
        <%= f.collection_check_boxes :scoped_account_ids, Organisation.order(:name), :id, :name do |b| %>
          <div class="checkbox-row"><%= b.check_box %><%= b.label %></div>
        <% end %>
      </fieldset>
    <% else %>
      <p><%= t("admin.users.form.scope_self_managed") %></p>
    <% end %>
  </fieldset>

  <div class="form-row">
    <%= f.label :locale, t("admin.users.fields.locale") %>
    <%= f.select :locale, I18n.available_locales.map { |l| [ t("locales.#{l}"), l.to_s ] },
          include_blank: t("forms.default") %>
  </div>

  <div class="form-row">
    <%= f.label :email_signature, t("admin.users.fields.email_signature") %>
    <%= f.text_area :email_signature, rows: 4, maxlength: 2_000 %>
    <p class="form-hint"><%= t("admin.users.fields.email_signature_hint") %></p>
  </div>

  <fieldset>
    <legend><%= t("admin.users.fields.queues") %></legend>
    <%= f.collection_check_boxes :queue_ids, CaseQueue.order(:name), :id, :name do |b| %>
      <div class="checkbox-row">
        <%= b.check_box %>
        <%= b.label %>
      </div>
    <% end %>
  </fieldset>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to t("actions.cancel"), admin_users_path, class: "btn" %>
  </div>
<% end %>
