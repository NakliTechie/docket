<%= form_with model: [ :admin, team ], class: "form" do |f| %>
  <%= render "shared/form_errors", record: team %>

  <div class="form-row <%= "field-error" if team.errors[:name].any? %>">
    <%= f.label :name, t("admin.teams.fields.name") %>
    <%= f.text_field :name, required: true %>
    <% team.errors[:name].each do |msg| %><p class="field-error-message"><%= msg %></p><% end %>
  </div>

  <div class="form-row">
    <%= f.label :description, t("admin.teams.fields.description") %>
    <%= f.text_area :description, rows: 3 %>
  </div>

  <fieldset>
    <legend><%= t("admin.teams.fields.members") %></legend>
    <p class="form-hint"><%= t("admin.teams.form.members_hint") %></p>
    <%= f.collection_check_boxes :member_ids, User.active.order(:name), :id, :display_label do |b| %>
      <div class="checkbox-row">
        <%= b.check_box %>
        <%= b.label %>
      </div>
    <% end %>
  </fieldset>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to t("actions.cancel"), admin_teams_path, class: "btn" %>
  </div>
<% end %>
