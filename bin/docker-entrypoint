#!/bin/bash -e

# Secret key base: never ship a usable default (a known key in a public
# repo lets anyone forge session cookies and reset tokens). If the
# operator hasn't supplied one, generate a unique key and persist it to
# the storage volume so it's stable across restarts but per-deployment.
# Done before any Rails command, which needs it to boot in production.
if [ -z "${SECRET_KEY_BASE}" ]; then
  SECRET_KEY_FILE="/rails/storage/secret_key_base"
  if [ ! -f "${SECRET_KEY_FILE}" ]; then
    ruby -rsecurerandom -e 'print SecureRandom.hex(64)' > "${SECRET_KEY_FILE}"
    chmod 600 "${SECRET_KEY_FILE}"
    echo "Generated a unique SECRET_KEY_BASE (persisted to storage volume)."
  fi
  export SECRET_KEY_BASE="$(cat "${SECRET_KEY_FILE}")"
fi

# Connector/OAuth credentials use a separate, versioned encryption keyring.
# The file contains no session-signing material and can be rotated independently.
VAULT_KEY_FILE="${DOCKET_VAULT_KEYS_PATH:-/rails/storage/vault_keys.json}"
if [ -z "${DOCKET_VAULT_KEYS}" ] && [ ! -f "${VAULT_KEY_FILE}" ]; then
  ruby -rjson -rsecurerandom -e 'print JSON.generate(active: "v1", keys: { "v1" => SecureRandom.hex(32) })' > "${VAULT_KEY_FILE}"
  chmod 600 "${VAULT_KEY_FILE}"
  echo "Generated a unique v1 credential-vault keyring (persisted to storage volume)."
fi

# Database preparation and first-create base seeding belong to the one-shot
# release/migrate process. Web replicas only boot the application, so they
# cannot race seeds or migrations.

exec "${@}"
